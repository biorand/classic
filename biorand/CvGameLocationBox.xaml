<UserControl x:Class="IntelOrca.Biohazard.BioRand.CvGameLocationBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:IntelOrca.Biohazard.BioRand"
             mc:Ignorable="d"
             x:Name="cvGameLocationBox"
             d:DesignWidth="400">
    <local:CheckGroupBox x:Name="groupBox" Header="Resident Evil CV:X" OnCheckedChanged="groupBox_OnCheckedChanged">
        <StackPanel>
            <Grid Margin="4,4,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Version:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="cbVersion"
                          Grid.Column="1"
                          HorizontalAlignment="Left"
                          MinWidth="90"
                          ToolTip="PS2 rebuilds the ISO. PC writes a mods/biorand pack and still uses the PS2 ISO for game data."
                          SelectionChanged="cbVersion_SelectionChanged">
                    <ComboBoxItem Content="PS2" />
                    <ComboBoxItem Content="PC" />
                </ComboBox>
            </Grid>
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="lblPcFolder"
                           Grid.Row="0"
                           Grid.Column="0"
                           Text="PC folder"
                           VerticalAlignment="Center"
                           Margin="4,4,2,4"
                           Visibility="Collapsed" />
                <TextBox x:Name="txtPcLocation"
                         Grid.Row="0"
                         Grid.Column="1"
                         Margin="4,4,2,4"
                         Visibility="Collapsed"
                         LostFocus="txtPcLocation_LostFocus" />
                <ComboBox x:Name="cbExecutables"
                          Grid.Row="0"
                          Grid.Column="2"
                          Margin="4,4,2,4"
                          Visibility="Collapsed"
                          SelectionChanged="cbExecutables_SelectionChanged" />
                <Button x:Name="btnBrowsePc"
                        Grid.Row="0"
                        Grid.Column="3"
                        Margin="2,4,4,4"
                        Visibility="Collapsed"
                        Click="btnBrowsePc_Click">...</Button>

                <TextBlock x:Name="lblIso"
                           Grid.Row="1"
                           Grid.Column="0"
                           Text="PS2 ISO"
                           VerticalAlignment="Center"
                           Margin="4,4,2,4" />
                <TextBox x:Name="txtIsoLocation"
                         Grid.Row="1"
                         Grid.Column="1"
                         Grid.ColumnSpan="2"
                         Margin="4,4,2,4"
                         LostFocus="txtIsoLocation_LostFocus" />
                <Button x:Name="btnBrowseIso"
                        Grid.Row="1"
                        Grid.Column="3"
                        Margin="2,4,4,4"
                        Click="btnBrowseIso_Click">...</Button>

                <TextBlock x:Name="txtPcValidationMessage"
                           Grid.Row="2"
                           Grid.Column="1"
                           Grid.ColumnSpan="3"
                           Margin="4,0,2,4"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
                <TextBlock x:Name="txtIsoValidationMessage"
                           Grid.Row="3"
                           Grid.Column="1"
                           Grid.ColumnSpan="3"
                           Margin="4,0,2,4"
                           TextWrapping="Wrap" />
            </Grid>
            <CheckBox x:Name="chkDoorSkip"
                      Margin="4,4,4,4"
                      Checked="chkDoorSkip_Changed"
                      Unchecked="chkDoorSkip_Changed">Door Skip</CheckBox>
        </StackPanel>
    </local:CheckGroupBox>
</UserControl>
